{
  "name": "inkwell",
  "version": "1.0.0",
  "description": "A minimal markdown editor with Kyoto aesthetics",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-all": "electron-builder -lwm"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.inkwell.editor",
    "productName": "inkwell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "icon.png"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
