{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkwell",
  "version": "../package.json",
  "identifier": "app.inkwell.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Inkwell",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "sarosaka-orz <sarosaka-orz@users.noreply.github.com>",
    "shortDescription": "A quiet, document-first Markdown editor",
    "longDescription": "Inkwell is a free, open-source Markdown editor that renders writing as you type. Headings, emphasis, code, math, diagrams, tables, and task lists appear inline while the Markdown source stays one keystroke away.",
    "copyright": "Copyright © 2026 Inkwell contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/sarosaka-orz/inkwell",
    "linux": {
      "deb": {
        "section": "editors"
      },
      "rpm": {
        "release": "1"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
